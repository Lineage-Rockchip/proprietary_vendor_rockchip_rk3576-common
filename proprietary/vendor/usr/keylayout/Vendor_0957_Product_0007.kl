key 114   VOLUME_DOWN  # громкость вниз
key 113   VOLUME_MUTE  # звук выкл.
key 104   PAGE_UP      # следующий канал / вверх по списку
key 109   PAGE_DOWN    # предыдущий канал / вниз по списку


key usage 0xc0089 TV		# TV
key usage 0xc002a MENU		# MENU
key usage 0xc000a SETTINGS	# SETTINGS
key usage 0xc0009 PROG_RED	# YOUTUBE
